# ─── Required ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── AI Providers (set at least one) ───────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── Local Services ────────────────────────────────────────────────────────
# Path to your Obsidian vault for the kollektiv MCP vault server
# OBSIDIAN_VAULT_PATH=C:/Users/you/path/to/your/vault

# Optional: Path to Topaz Gigapixel AI executable for image upscaling
# TOPAZ_GIGAPIXEL_PATH=C:/Program Files/Topaz Labs LLC/Topaz Gigapixel AI/gigapixel.exe

# ─── Multi-Engine Web Search ────────────────────────────────────────────────
# Comma-separated list of search engines to use when no explicit
# selection is passed. Default: duckduckgo,brave
# DEFAULT_SEARCH_ENGINES=duckduckgo,brave

# If set, restricts which engines can be activated at runtime.
# Comma-separated list of engine names. If empty, all are allowed.
# ALLOWED_SEARCH_ENGINES=

# Exa search API key (free tier available at exa.ai).
# Exa engine is skipped when this is absent.
# EXA_API_KEY=

# Bing search strategy. Default: request
#   request    — HTTP fetch only (Bing SERP is JS-rendered, likely empty)
#   auto       — try HTTP first, fall back to Playwright headless browser
#   playwright — force Playwright browser rendering
# SEARCH_MODE=request

# ─── Core Configuration ────────────────────────────────────────────────────
# PORT=7500
# HOST=127.0.0.1
