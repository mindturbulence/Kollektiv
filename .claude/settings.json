{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell"
    ],
    "deny": [
      "Bash(pnpm dev*)",
      "Bash(pnpm start*)",
      "Bash(npx tsx server.ts*)",
      "Bash(pnpm preview*)",
      "Bash(vitest --watch*)",
      "Bash(vitest watch*)",
      "Bash(pnpm exec vitest --watch*)",
      "PowerShell(Start-Process*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "BASH_MAX_OUTPUT_LENGTH": "60000",
    "CLAUDE_CODE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  }
}
